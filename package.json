{
  "name": "chaintrace-mcp",
  "version": "0.1.0",
  "description": "Read-only Solana blockchain data MCP server",
  "type": "module",
  "bin": {
    "chaintrace-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
